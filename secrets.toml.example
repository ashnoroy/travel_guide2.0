# .streamlit/secrets.toml.example
#
# Copy this file to .streamlit/secrets.toml (LOCAL dev) and fill in real
# values, OR paste the filled-in contents into your app's "Secrets" panel
# in Streamlit Community Cloud settings (deployed).
#
# NEVER commit the real secrets.toml to GitHub - add
# ".streamlit/secrets.toml" to your .gitignore.
#
# Where to get client_id / client_secret:
#   1. Go to https://console.cloud.google.com/auth/overview (Google Auth Platform)
#   2. Create (or select) a project, configure the OAuth consent screen
#   3. Create an OAuth client ID -> Application type: "Web application"
#   4. Under "Authorized redirect URIs" add EXACTLY the redirect_uri below
#      - local dev:   http://localhost:8501/oauth2callback
#      - deployed:    https://<your-app-name>.streamlit.app/oauth2callback
#   5. Copy the generated Client ID and Client Secret into the values below

[auth]
# Any random long string - used to sign Streamlit's auth cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "def123"

# Must match one of the "Authorized redirect URIs" in your Google OAuth client.
# Update this to your deployed app's URL once you push to Streamlit Cloud.
redirect_uri = "http://localhost:8501/oauth2callback"

[auth.google]
client_id = "274294475828-hf8nc1ti3n27ao0j6hppk7i2knrrbspn.apps.googleusercontent.com"
client_secret = "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"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
